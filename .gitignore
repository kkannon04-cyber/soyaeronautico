# Local Netlify folder
.netlify

# Informes de seguridad: nunca deben publicarse (netlify.toml usa publish = "."
# sin exclusiones, así que cualquier carpeta del repo se sirve tal cual).
reportes-seguridad/

# Variables de entorno locales (API keys y secretos) — nunca deben subirse a GitHub.
# netlify dev lee .env automáticamente; en producción las variables se configuran
# en el dashboard de Netlify, no en un archivo.
.env
.env.local
.env.*.local
